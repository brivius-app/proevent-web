---
interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'PROevent — Sonido e Iluminación',
  description = 'Sonido, iluminación y pantallas LED para casamientos, corporativos, XV, shows en vivo y eventos privados.',
} = Astro.props;
---

<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{title}</title>
<meta name="description" content={description}>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Sora:wght@400;500;600;700;800&family=Barlow+Condensed:wght@500;600;700&display=swap" rel="stylesheet">
<script src="https://identity.netlify.com/v1/netlify-identity-widget.js"></script>
</head>
<body>
<slot />
<script is:inline>
  // Redirige al panel /admin tras aceptar la invitación de Netlify Identity.
  if (window.netlifyIdentity) {
    window.netlifyIdentity.on('init', (user) => {
      if (!user) {
        window.netlifyIdentity.on('login', () => {
          document.location.href = '/admin/';
        });
      }
    });
  }
</script>
</body>
</html>

<style is:global>
  :root{
    --orange:#FF6A00;
    --orange-soft:#ff8a33;
    --ink:#0a0a0d;
    --ink-2:#121218;
    --ink-3:#1a1a22;
    --line:rgba(255,255,255,.08);
    --txt:#ececf0;
    --muted:#9a9aa6;
    --display:'Barlow Condensed',sans-serif;
    --body:'Sora',sans-serif;
  }
  *{margin:0;padding:0;box-sizing:border-box}
  html{scroll-behavior:smooth}
  body{background:var(--ink);color:var(--txt);font-family:var(--body);line-height:1.6;overflow-x:hidden}
  a{color:inherit;text-decoration:none}
  img{max-width:100%;display:block}

  header{position:fixed;top:0;left:0;right:0;z-index:50;display:flex;align-items:center;justify-content:space-between;
    padding:18px 40px;transition:background .3s,padding .3s}
  header.scrolled{background:rgba(10,10,13,.92);backdrop-filter:blur(12px);padding:12px 40px;border-bottom:1px solid var(--line)}
  header .logo{height:40px}
  nav{display:flex;align-items:center;gap:28px;font-size:14px;font-weight:500;letter-spacing:.3px}
  nav a{color:var(--txt);opacity:.85;transition:opacity .2s}
  nav a:hover{opacity:1;color:var(--orange)}
  .nav-cta{border:1px solid var(--orange);color:var(--orange)!important;padding:8px 18px;border-radius:40px;font-weight:600;transition:all .25s}
  .nav-cta:hover{background:var(--orange);color:var(--ink)!important}
  .burger{display:none;font-size:26px;cursor:pointer;color:var(--orange);background:none;border:none}

  .hero{position:relative;height:100vh;min-height:600px;display:flex;align-items:center;overflow:hidden}
  .hero video{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;filter:saturate(1.15) contrast(1.05)}
  .hero .overlay{position:absolute;inset:0;background:linear-gradient(105deg,rgba(10,10,13,.9) 0%,rgba(10,10,13,.55) 45%,rgba(10,10,13,.25) 100%)}
  .hero .vignette{position:absolute;inset:0;box-shadow:inset 0 -160px 120px -40px var(--ink),inset 0 120px 100px -60px rgba(10,10,13,.7)}
  .hero-inner{position:relative;z-index:3;padding:0 40px;max-width:820px}
  .eyebrow{display:inline-flex;align-items:center;gap:10px;color:var(--orange);font-family:var(--display);
    font-weight:600;letter-spacing:4px;text-transform:uppercase;font-size:16px;margin-bottom:18px}
  .eyebrow::before{content:"";width:34px;height:2px;background:var(--orange)}
  .hero h1{font-family:var(--display);font-weight:700;font-size:clamp(48px,7vw,104px);line-height:.95;text-transform:uppercase;letter-spacing:-1px}
  .hero h1 span{color:var(--orange);display:block}
  .hero p{margin-top:22px;max-width:480px;font-size:18px;color:#d6d6de}
  .hero-actions{margin-top:34px;display:flex;gap:16px;flex-wrap:wrap}
  .btn{display:inline-flex;align-items:center;gap:10px;padding:15px 30px;border-radius:44px;font-weight:600;font-size:15px;transition:transform .2s,box-shadow .2s,background .2s;cursor:pointer;border:none;font-family:var(--body)}
  .btn-primary{background:var(--orange);color:var(--ink);box-shadow:0 10px 40px -10px rgba(255,106,0,.6)}
  .btn-primary:hover{transform:translateY(-2px);box-shadow:0 16px 50px -8px rgba(255,106,0,.8)}
  .btn-ghost{border:1px solid rgba(255,255,255,.25);color:#fff;background:none}
  .btn-ghost:hover{border-color:var(--orange);color:var(--orange)}
  .scroll-hint{position:absolute;bottom:26px;left:50%;transform:translateX(-50%);z-index:3;color:var(--muted);font-size:12px;letter-spacing:2px;text-transform:uppercase;display:flex;flex-direction:column;align-items:center;gap:8px}
  .scroll-hint .line{width:1px;height:40px;background:linear-gradient(var(--orange),transparent);animation:drop 1.8s infinite}
  @keyframes drop{0%{transform:scaleY(0);transform-origin:top}50%{transform:scaleY(1);transform-origin:top}51%{transform-origin:bottom}100%{transform:scaleY(0);transform-origin:bottom}}

  section{padding:110px 40px;position:relative}
  .sec-head{max-width:1240px;margin:0 auto 56px}
  .sec-tag{color:var(--orange);font-family:var(--display);font-weight:600;letter-spacing:4px;text-transform:uppercase;font-size:15px;margin-bottom:12px;display:flex;align-items:center;gap:10px}
  .sec-tag::before{content:"";width:26px;height:2px;background:var(--orange)}
  .sec-head h2{font-family:var(--display);font-weight:700;text-transform:uppercase;font-size:clamp(34px,4.5vw,60px);line-height:1;letter-spacing:-.5px}
  .sec-head p{margin-top:16px;color:var(--muted);max-width:560px;font-size:16px}

  .services{background:var(--ink-2);border-top:1px solid var(--line);border-bottom:1px solid var(--line)}
  .svc-grid{max-width:1240px;margin:0 auto;display:grid;grid-template-columns:repeat(3,1fr);gap:24px}
  .svc{background:var(--ink-3);border:1px solid var(--line);border-radius:18px;padding:38px 32px;transition:all .3s;position:relative;overflow:hidden}
  .svc::after{content:"";position:absolute;top:0;left:0;width:100%;height:3px;background:var(--orange);transform:scaleX(0);transform-origin:left;transition:transform .35s}
  .svc:hover{transform:translateY(-6px);border-color:rgba(255,106,0,.35)}
  .svc:hover::after{transform:scaleX(1)}
  .svc .ic{width:56px;height:56px;border-radius:14px;background:rgba(255,106,0,.12);display:flex;align-items:center;justify-content:center;font-size:26px;margin-bottom:22px}
  .svc h3{font-family:var(--display);font-size:26px;text-transform:uppercase;letter-spacing:.5px;margin-bottom:10px}
  .svc p{color:var(--muted);font-size:15px}

  .filters{max-width:1240px;margin:0 auto 34px;display:flex;gap:12px;flex-wrap:wrap}
  .filter{padding:9px 20px;border-radius:40px;border:1px solid var(--line);background:transparent;color:var(--muted);font-family:var(--body);font-size:14px;font-weight:500;cursor:pointer;transition:all .2s}
  .filter:hover{color:#fff;border-color:rgba(255,255,255,.3)}
  .filter.active{background:var(--orange);color:var(--ink);border-color:var(--orange);font-weight:600}

  .grid{max-width:1240px;margin:0 auto;display:grid;grid-template-columns:repeat(3,1fr);gap:18px}
  .card{position:relative;aspect-ratio:4/5;border-radius:16px;overflow:hidden;cursor:pointer;background:var(--ink-3);border:1px solid var(--line);transition:transform .3s}
  .card:hover{transform:scale(.985)}
  .card img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;transition:transform .5s}
  .card:hover img{transform:scale(1.06)}
  .card .grad{position:absolute;inset:0;background:linear-gradient(to top,rgba(10,10,13,.92) 0%,transparent 55%);z-index:2}
  .card .meta{position:absolute;left:0;bottom:0;z-index:3;padding:22px;transform:translateY(6px);opacity:.95;transition:all .3s}
  .card:hover .meta{transform:translateY(0);opacity:1}
  .card .cat{color:var(--orange);font-size:12px;font-weight:600;letter-spacing:2px;text-transform:uppercase}
  .card h4{font-family:var(--display);font-size:26px;text-transform:uppercase;margin-top:2px}
  .card .count{display:inline-flex;align-items:center;gap:6px;margin-top:8px;font-size:12px;color:#d6d6de;background:rgba(0,0,0,.4);padding:4px 12px;border-radius:20px;backdrop-filter:blur(4px)}
  .card .plus{position:absolute;top:16px;right:16px;z-index:3;width:38px;height:38px;border-radius:50%;background:rgba(255,106,0,.9);color:var(--ink);display:flex;align-items:center;justify-content:center;font-size:22px;opacity:0;transform:rotate(-90deg);transition:all .3s}
  .card:hover .plus{opacity:1;transform:rotate(0)}

  .stats{background:var(--ink-2);border-top:1px solid var(--line);border-bottom:1px solid var(--line)}
  .stat-grid{max-width:1100px;margin:0 auto;display:grid;grid-template-columns:repeat(4,1fr);gap:20px;text-align:center}
  .stat .num{font-family:var(--display);font-weight:700;font-size:clamp(44px,5vw,72px);color:var(--orange);line-height:1}
  .stat .lbl{color:var(--muted);font-size:14px;letter-spacing:1px;text-transform:uppercase;margin-top:6px}

  .cta{text-align:center;background:radial-gradient(circle at 50% 0%,rgba(255,106,0,.14),transparent 60%),var(--ink)}
  .cta h2{font-family:var(--display);font-weight:700;text-transform:uppercase;font-size:clamp(38px,5.5vw,76px);line-height:.95}
  .cta h2 span{color:var(--orange)}
  .cta p{color:var(--muted);margin:20px auto 34px;max-width:480px}

  footer{background:var(--ink);border-top:1px solid var(--line);padding:60px 40px 34px}
  .foot-grid{max-width:1240px;margin:0 auto;display:flex;justify-content:space-between;gap:40px;flex-wrap:wrap;align-items:flex-start}
  footer .logo{height:46px;margin-bottom:18px}
  .foot-col h5{font-family:var(--display);text-transform:uppercase;letter-spacing:1px;color:#fff;margin-bottom:14px;font-size:18px}
  .foot-col a,.foot-col p{display:block;color:var(--muted);font-size:14px;margin-bottom:9px;transition:color .2s}
  .foot-col a:hover{color:var(--orange)}
  .socials{display:flex;gap:12px;margin-top:6px}
  .socials a{width:40px;height:40px;border:1px solid var(--line);border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:18px;transition:all .25s}
  .socials a:hover{background:var(--orange);color:var(--ink);border-color:var(--orange)}
  .foot-bottom{max-width:1240px;margin:44px auto 0;padding-top:22px;border-top:1px solid var(--line);display:flex;justify-content:space-between;color:#55555f;font-size:13px;flex-wrap:wrap;gap:8px}

  .wa{position:fixed;right:24px;bottom:24px;z-index:60;width:60px;height:60px;border-radius:50%;background:#25D366;display:flex;align-items:center;justify-content:center;font-size:30px;color:#fff;box-shadow:0 8px 30px rgba(37,211,102,.5);transition:transform .2s;animation:pulse 2.5s infinite}
  .wa:hover{transform:scale(1.08)}
  @keyframes pulse{0%{box-shadow:0 8px 30px rgba(37,211,102,.5),0 0 0 0 rgba(37,211,102,.5)}70%{box-shadow:0 8px 30px rgba(37,211,102,.5),0 0 0 16px rgba(37,211,102,0)}100%{box-shadow:0 8px 30px rgba(37,211,102,.5),0 0 0 0 rgba(37,211,102,0)}}

  /* LIGHTBOX / GALERÍA */
  .lb{position:fixed;inset:0;z-index:100;background:rgba(8,8,11,.97);backdrop-filter:blur(8px);display:none;flex-direction:column;opacity:0;transition:opacity .3s}
  .lb.open{display:flex;opacity:1}
  .lb-top{display:flex;align-items:center;justify-content:space-between;padding:20px 30px;border-bottom:1px solid var(--line)}
  .lb-title{font-family:var(--display);text-transform:uppercase;font-size:26px;letter-spacing:.5px}
  .lb-title span{color:var(--orange)}
  .lb-close{background:none;border:1px solid var(--line);color:#fff;width:44px;height:44px;border-radius:50%;font-size:22px;cursor:pointer;transition:all .2s}
  .lb-close:hover{background:var(--orange);color:var(--ink);border-color:var(--orange)}
  .lb-body{flex:1;overflow-y:auto;padding:30px}
  .lb-grid{max-width:1200px;margin:0 auto;display:grid;grid-template-columns:repeat(auto-fill,minmax(280px,1fr));gap:16px}
  .lb-grid img{width:100%;border-radius:12px;cursor:zoom-in;border:1px solid var(--line);transition:transform .3s}
  .lb-grid img:hover{transform:scale(1.02)}
  /* Zoom individual */
  .zoom{position:fixed;inset:0;z-index:110;background:rgba(0,0,0,.94);display:none;align-items:center;justify-content:center;padding:30px;cursor:zoom-out}
  .zoom.open{display:flex}
  .zoom img{max-width:95%;max-height:92%;border-radius:8px}
  .zoom .znav{position:absolute;top:50%;transform:translateY(-50%);background:rgba(255,106,0,.9);color:var(--ink);border:none;width:52px;height:52px;border-radius:50%;font-size:26px;cursor:pointer;display:flex;align-items:center;justify-content:center;transition:transform .2s}
  .zoom .znav:hover{transform:translateY(-50%) scale(1.1)}
  .zoom .zprev{left:20px}.zoom .znext{right:20px}
  .zoom .zclose{position:absolute;top:20px;right:20px;width:46px;height:46px;font-size:22px;background:none;border:1px solid rgba(255,255,255,.3);color:#fff;border-radius:50%;cursor:pointer}

  .reveal{opacity:0;transform:translateY(30px);transition:opacity .7s,transform .7s}
  .reveal.in{opacity:1;transform:none}

  @media(max-width:860px){
    header{padding:14px 20px}
    nav{position:fixed;inset:0;background:rgba(10,10,13,.98);flex-direction:column;justify-content:center;gap:30px;font-size:22px;transform:translateX(100%);transition:transform .35s}
    nav.open{transform:none}
    .burger{display:block;z-index:60}
    .svc-grid,.grid,.stat-grid{grid-template-columns:1fr}
    .stat-grid{grid-template-columns:1fr 1fr;gap:34px}
    .grid{grid-template-columns:1fr 1fr;gap:12px}
    .hero-inner{padding:0 20px}
    section{padding:80px 20px}
  }
  @media(max-width:520px){.grid{grid-template-columns:1fr}}
</style>

---
import { getCollection } from 'astro:content';

const entries = await getCollection('portfolio');

const cats = entries
  .sort((a, b) => (a.data.order ?? 0) - (b.data.order ?? 0))
  .map((e) => {
    const gallery = e.data.gallery ?? [];
    return {
      id: e.data.slug ?? e.id,
      label: e.data.label,
      title: e.data.title,
      cover: e.data.cover,
      count: gallery.length,
      // La galería del lightbox muestra la portada primero + las fotos.
      images: [e.data.cover, ...gallery],
    };
  });
---
<section id="trabajos">
  <div class="sec-head reveal">
    <div class="sec-tag">Portfolio</div>
    <h2>Nuestros trabajos</h2>
    <p>Elegí una categoría y hacé click para ver la galería completa de cada tipo de evento.</p>
  </div>
  <div class="filters" id="filters">
    <button class="filter active" data-f="all">Todos</button>
    {cats.map((c) => <button class="filter" data-f={c.id}>{c.label}</button>)}
  </div>
  <div class="grid" id="grid">
    {cats.map((c) => (
      <div class="card reveal" data-cat={c.id}>
        <img src={c.cover} alt={c.label} loading="lazy" />
        <div class="grad"></div><div class="plus">↗</div>
        <div class="meta"><div class="cat">{c.label}</div><h4>{c.title}</h4>
        <span class="count">📷 {c.count} {c.count === 1 ? 'foto' : 'fotos'}</span></div>
      </div>
    ))}
  </div>
</section>

<script type="application/json" id="portfolio-data" set:html={JSON.stringify(cats)}></script>

<div class="lb" id="lb">
  <div class="lb-top">
    <div class="lb-title" id="lb-title"></div>
    <button class="lb-close" id="lb-close" aria-label="Cerrar">✕</button>
  </div>
  <div class="lb-body"><div class="lb-grid" id="lb-grid"></div></div>
</div>

<div class="zoom" id="zoom">
  <button class="zclose" id="z-close" aria-label="Cerrar">✕</button>
  <button class="znav zprev" id="z-prev" aria-label="Anterior">‹</button>
  <img id="z-img" src="" alt="">
  <button class="znav znext" id="z-next" aria-label="Siguiente">›</button>
</div>

<script>
  const CATS = JSON.parse(document.getElementById('portfolio-data').textContent);

  // Las cards se renderizan en el servidor; acá enganchamos la apertura de galería.
  document.querySelectorAll('#grid .card').forEach((card) => {
    const c = CATS.find((x) => x.id === card.dataset.cat);
    if (c) card.onclick = () => openGallery(c);
  });

  document.querySelectorAll('.filter').forEach(f=>f.onclick=()=>{
    document.querySelectorAll('.filter').forEach(x=>x.classList.remove('active'));
    f.classList.add('active');const v=f.dataset.f;
    document.querySelectorAll('#grid .card').forEach(c=>{
      c.style.display=(v==='all'||c.dataset.cat===v)?'':'none';
    });
  });

  const lb=document.getElementById('lb'),lbGrid=document.getElementById('lb-grid'),lbTitle=document.getElementById('lb-title');
  let currentImgs=[];
  function openGallery(c){
    lbTitle.innerHTML=`${c.label} <span>/ galería</span>`;
    lbGrid.innerHTML='';currentImgs=c.images.slice();
    currentImgs.forEach((src,idx)=>{
      const im=document.createElement('img');im.src=src;im.loading='lazy';im.alt=`${c.label} ${idx+1}`;
      im.onclick=()=>openZoom(idx);
      lbGrid.appendChild(im);
    });
    lb.classList.add('open');document.body.style.overflow='hidden';
  }
  document.getElementById('lb-close').onclick=()=>{lb.classList.remove('open');document.body.style.overflow=''};
  lb.onclick=e=>{if(e.target===lb){lb.classList.remove('open');document.body.style.overflow=''}};

  const zoom=document.getElementById('zoom'),zImg=document.getElementById('z-img');let zIdx=0;
  function openZoom(i){zIdx=i;zImg.src=currentImgs[zIdx];zoom.classList.add('open')}
  document.getElementById('z-close').onclick=()=>zoom.classList.remove('open');
  document.getElementById('z-next').onclick=e=>{e.stopPropagation();zIdx=(zIdx+1)%currentImgs.length;zImg.src=currentImgs[zIdx]};
  document.getElementById('z-prev').onclick=e=>{e.stopPropagation();zIdx=(zIdx-1+currentImgs.length)%currentImgs.length;zImg.src=currentImgs[zIdx]};
  zoom.onclick=e=>{if(e.target===zoom)zoom.classList.remove('open')};
  document.addEventListener('keydown',e=>{
    if(zoom.classList.contains('open')){
      if(e.key==='Escape')zoom.classList.remove('open');
      if(e.key==='ArrowRight')document.getElementById('z-next').click();
      if(e.key==='ArrowLeft')document.getElementById('z-prev').click();
    }else if(lb.classList.contains('open')&&e.key==='Escape'){lb.classList.remove('open');document.body.style.overflow=''}
  });

  const io=new IntersectionObserver(es=>es.forEach(e=>{if(e.isIntersecting){e.target.classList.add('in');io.unobserve(e.target)}}),{threshold:.12});
  document.querySelectorAll('.reveal').forEach(el=>io.observe(el));
</script>

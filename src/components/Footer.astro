---
import { waUrl, mailto, EMAIL, PHONE_DISPLAY } from '../lib/site';
---
<footer>
  <div class="foot-grid">
    <div class="foot-col">
      <img src="/assets/logos/logo-blanco.png" alt="PROevent" class="logo">
      <p style="max-width:240px">Sonido, iluminación y pantallas LED para eventos.</p>
    </div>
    <div class="foot-col">
      <h5>Navegación</h5>
      <a href="#servicios">Servicios</a>
      <a href="#trabajos">Trabajos</a>
      <a href="#nosotros">Nosotros</a>
      <a href="#contacto">Contacto</a>
    </div>
    <div class="foot-col">
      <h5>Contacto</h5>
      <p>{EMAIL}</p>
      <a href={waUrl}>{PHONE_DISPLAY}</a>
      <div class="socials">
        <a href="#" aria-label="Instagram">◎</a>
        <a href={waUrl} aria-label="WhatsApp">✆</a>
        <a href={mailto} aria-label="Email">✉</a>
      </div>
    </div>
  </div>
  <div class="foot-bottom">
    <span>PROevent © 2026 — Todos los derechos reservados</span>
    <span>Sonido e Iluminación</span>
  </div>
</footer>
